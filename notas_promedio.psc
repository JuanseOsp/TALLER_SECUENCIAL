Algoritmo notas_promedio
	Definir notaUno, notaDos, notaTres, notaCuatro Como Real
	Escribir "Valor nota 1: "
	Leer notaUno
	Escribir "Valor nota 2: "
	Leer notaDos
	Escribir "Valor nota 3: "
	Leer notaTres
	Escribir "Valor nota 4: "
	Leer notaCuatro
	Escribir "El valor total de sus notas es: " (notaUno + notaDos + notaTres + notaCuatro) / 4
FinAlgoritmo
