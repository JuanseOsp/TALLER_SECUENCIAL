Algoritmo calculo_salario
	Definir numeroHoras, valorHora, pagoSalario Como Real
	Escribir "Cúal es el valor de la hora pagada: "
	Leer valorHora
	Escribir "Numero de horas trabajadas: "
	Leer numeroHoras
	pagoSalario = valorHora * numeroHoras
	Escribir "El valor pagado es de: " , pagoSalario
FinAlgoritmo
