Algoritmo triangulo_rectangulo
	Definir cateto1, cateto2, hipotenusa Como Real
	Escribir "¿Cuál es el cateto 1?: "
	Leer cateto1
	Escribir "¿Cuál es el cateto 2?: "
	Leer cateto2
	hipotenusa = RAIZ ((cateto1 * cateto1) + (cateto2 * cateto2))
	Imprimir "La hipotenusa del triangulo-rectangulo es de: ", hipotenusa
FinAlgoritmo
