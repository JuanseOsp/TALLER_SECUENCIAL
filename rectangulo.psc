Algoritmo rectangulo
	Definir base, altura, area, perimetro Como Real
	Escribir "¿Cuál es la base del rectangulo?: "
	Leer base
	Escribir "¿Cuál es la altura del rectangulo?: "
	Leer altura
	area = base * altura
	perimetro = 2 * (base + altura)
	Imprimir "El area del rectangulo es de: ", area
	Imprimir "El perimetro del rectangulo es: ", perimetro
FinAlgoritmo
