Algoritmo PRINCIPALES_FUNCIONES
	Definir numeroUno, seno, coseno, tangente Como Real
	Definir raizz, logaritmoNatural, logaritmo10 Como Real
	

	Imprimir "Ingrese su numero: "
	leer numeroUno
	seno = sen(numeroUno)
	coseno = cos(numeroUno)
	tangente = tan (numeroUno)
	raizz = rc(numeroUno)
	logaritmoNatural = ln (numeroUno)
	logaritmo10 = ln (numeroUno) / ln (10)
	Imprimir "Del numero: ", numeroUno
	Imprimir "Su seno es: ", seno
	Imprimir "Su coseno es: ", coseno
	Imprimir "Su tangente es: ", tangente
	Imprimir "Su raiz es: ", raizz
	Imprimir "Su logaritmo natural es: ", logaritmoNatural
	Imprimir "Su logaritmo10 en base 10 es: ", logaritmo10
FinAlgoritmo 
