Algoritmo promedio_numeros
	Definir numeroUno, numeroDos, numeroTres, promedioAritmetico Como Real
	Escribir "¿Cuál es tu primer numero?: "
	Leer numeroUno
	Escribir "¡Cuál es tu segundo numero?: "
	Leer numeroDos
	Escribir "¿Cuál es tu tercer numero?: "
	Leer numeroTres
	promedioAritmetico = (numeroUno + numeroDos + numeroTres) / 3
	Imprimir "El promedio de los tres numeros es de: ", promedioAritmetico
	
FinAlgoritmo
